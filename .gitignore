# Secrets — never commit
.env
.env.*
!.env.example

# Raw real-world datasets (large; used only for calibration)
data/raw/*
!data/raw/.gitkeep

# Local databases (rebuilt by scripts/seed_db.py), SQLite side files and moved-aside copies
*.db
*.sqlite
*.db-journal
*.db-wal
*.db-shm
*.db.stale

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
dist/
frontend/.vite/
playwright-report/
test-results/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Copy this file to .env and fill in your own values. Never commit .env.

# Telegram — get a token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the backend in the cloud (leave empty locally → bot uses polling)
WEBHOOK_URL=
# Random string Telegram echoes back on webhook calls, so we can reject forged requests
TELEGRAM_WEBHOOK_SECRET=

# Anthropic — https://console.anthropic.com (set a monthly spend limit!)
ANTHROPIC_API_KEY=
# Daily token budget across all Claude calls; above this the engine falls back to rules-only offers
CLAUDE_DAILY_TOKEN_BUDGET=2000000
# Kill switch: 0 sends every decision down the rules-only path (no Claude calls)
OFFERIQ_AI_ENABLED=1

# Database — SQLite locally, Postgres (e.g. Neon) in the cloud
DATABASE_URL=sqlite:///./offeriq.db

# Dashboard login (used once auth lands)
DASHBOARD_PASSWORD=

# Environment: local | cloud
APP_ENV=local
